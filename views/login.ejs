<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h1 class="text-3xl mb-5">Login accound</h1>
        <form action="/login" method="post">
            <input type="email" placeholder="email" name="email" class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800">
            <input type="password" placeholder="password" name="password" class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800">
            <input type="submit" value="Login account" class="bg-blue-600 px-4 py-2 rounded-md">
        </form>
    </div>
  </body>
</html>
