<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h1 class="text-3xl mb-5">Update proflie picture</h1>
        <form action="/upload" method="post" enctype="multipart/form-data">
            <div class="my-3">
              <label for="file" class="bg-red-600 py-2 px-3 rounded-md">Change Photo</label>
              <input type="file" name="image" id="file" class="hidden">
            </div>
            <div class="w-100 h-100 bg-zinc-800 my-3">
              <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" alt="" srcset="">
            </div>
            <input type="submit" value="Update PP" class="bg-blue-600 px-4 py-2 rounded-md">
        </form>
    </div>
  </body>
</html>
