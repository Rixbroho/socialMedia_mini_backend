<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
      <div class="flex items-center justify-between mb-5">
        <h1>Profile</h1>
        <a href="/logout" class="bg-red-600 px-3 py-3 rounded-md text-sm"
          >Logout</a
        >
      </div>
      <h5 class="mb-5">you can edit your post.</h5>
      <form action="/update/<%= post._id %>" method="post">
        <textarea
          name="content"
          id=""
          placeholder="What's on your mind?"
          class="w-2/3 h-30 px-3 py-2 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md"
        ><%= post.content %></textarea>
        <input
          type="submit"
          value="Update post"
          class="w-40 px-3 py-2 bg-blue-500 block rounded-md mt-2"
        />
      </form>
    </div>
  </body>
</html>
