<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex items-center justify-between mb-5">
            <h1>Profile</h1>
            <a href="/logout" class="bg-red-600 px-3 py-3 rounded-md text-sm">Logout</a>
        </div>
        <h3 class="text-3xl"><span class="font-light">Hello</span>, <%= user.name %></h3>
        <h5 class="mb-5">you can create a new post.</h5>
        <form action="/post" method="post">
            <textarea name="content" id="" placeholder="What's on your mind?" class="w-2/3 h-30 px-3 py-2 outline-none resize-none bg-transparent border-2 border-zinc-800 rounded-md"></textarea>
            <input type="submit" value="Create new post" class="w-40 px-3 py-2 bg-blue-500 block rounded-md mt-2">
        </form>
        <div class="posts mt-20">
            <h3 class="text-zinc-400">Your Posts.</h3>
            <div class="postcontainer mt-5">
                <% user.posts.reverse().forEach((post)=>{ %> 
                    <div class="post w-2/3 p-4 mb-2 rounded-md border-[1px] border-zinc-700 bg-zinc-800">
                        <h4 class="text-blue-500 mb-2">@<%= user.username %></h4>
                        <p class="text-sm tracking-tight whitespace-pre-line"><%= post.content %></p>
                        <small class="mt-4 inline-block"><%= post.likes.length %> likes</small>
                        <div class="flex btns gap-4 mt-1">
                            <% if(post.likes.indexOf(user._id)===0){ %>
                                <a href="/like/<%= post.id %>" class="text-red-500 w-12">Unlike</a>
                            <% }else{ %>
                                <a href="/like/<%= post.id %>" class="text-blue-500 w-12">Like</a>
                            <% } %>
                            <a href="/edit/<%= post.id %>" class="text-zinc-600">Edit</a>
                        </div>
                    </div>
                <% }) %>                
            </div>
        </div>
    </div>
  </body>
</html>
